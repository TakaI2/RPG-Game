  {
    "id": "npc_1775505244856",
    "name": "犠牲者1",
    "spriteKey": "victhim3_l",
    "animated": true,
    "movement": "fixed",
    "speechLines": [
      "あ・・・、あぁ・・・",
      "すって・・・、もっと・・・、もっと・・・"
    ],
    "speechIntervalMs": 5000,
    "dialogLines": [
      {
        "name": "ベルナデット",
        "text": "あ～あ、サキュバスに襲われたのね、すっかり壊れてる・・・。"
      },
      {
        "name": "ベルナデット",
        "text": "体液が垂れ流し。干乾びるのも時間の問題ね。"
      }
    ],
    "frameRate": 4
  },
