[
  {
    "id": "npc_villager_001",
    "name": "村人",
    "spriteKey": "npc_villager",
    "animated": false,
    "movement": "fixed",
    "speechLines": [
      "こんにちは！",
      "気をつけてね"
    ],
    "speechIntervalMs": 5000,
    "dialogLines": [
      {
        "name": "ベルナデット",
        "text": "この先には魔物がいるから気をつけて！"
      }
    ]
  },
  {
    "id": "npc_1775354231905",
    "name": "村人",
    "spriteKey": "victhim2",
    "animated": true,
    "movement": "fixed",
    "speechLines": [
      "うううぅ・・・、溶ける・・・体が・・・",
      "あつい・・・、身体が熱い・・・"
    ],
    "speechIntervalMs": 5000,
    "dialogLines": [
      {
        "name": "ベルナデット",
        "text": "磔にされて、寄って集って襲われたか。　キス痕だらけ。"
      },
      {
        "name": "ベルナデット",
        "text": "サキュバス特有の「遊び」ね・・・。汚らわしい。"
      },
      {
        "name": "ベルナデット",
        "text": "壊れた蛇口みたいに体液垂れ流して・・・、強い魅了の呪いが掛けられてるのかしら。"
      },
      {
        "name": "ベルナデット",
        "text": "呪いをかけたのはあのリアラってやつかしら？"
      }
    ]
  },
